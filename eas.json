{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "bundleIdentifier": "com.mio.yarr.dev"
      },
      "android": {
        "package": "com.mio.yarr.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview"
      },
      "ios": {
        "bundleIdentifier": "com.mio.yarr.dev"
      },
      "android": {
        "package": "com.mio.yarr.dev"
      }
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "ios": {
        "bundleIdentifier": "com.mio.yarr"
      },
      "android": {
        "package": "com.mio.yarr"
      }
    }
  }
}
