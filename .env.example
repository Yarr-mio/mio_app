# 로컬 pnpm start 전용 EAS 클라우드 빌드는 eas.json env 와 EAS_BUILD_PROFILE 사용
# production 으로 두면 Metro expoConfig 와 카카오 JS 키가 production 으로 고정됨
APP_VARIANT=development

# API
EXPO_PUBLIC_API_BASE_URL=실제 배포 서버

# API 서버 사용시 false로 변경 임시
EXPO_PUBLIC_USE_MOCK=false

EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=production용 카카오 네이티브 앱 키
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY_DEV=dev용 카카오 네이티브 앱 키
